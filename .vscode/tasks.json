{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Base de datos: levantar",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
      "problemMatcher": []
    },
    {
      "label": "Base de datos: detener",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.dev.yml stop",
      "problemMatcher": []
    },
    {
      "label": "Calidad: lint + tipos + tests",
      "type": "shell",
      "command": "pnpm lint && pnpm typecheck && pnpm test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Dominio: regenerar Dart de la app",
      "type": "shell",
      "command": "pnpm --filter @chucarit/shared gen:dart",
      "problemMatcher": []
    }
  ]
}
